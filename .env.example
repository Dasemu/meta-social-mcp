# Copy this file to .env and fill in the values

# Access token (long-lived, 60 days) of the admin user of the page/IG account
META_ACCESS_TOKEN=

# App ID and App Secret of your app on developers.facebook.com
META_APP_ID=
META_APP_SECRET=

# Obtained with: npm run get-ids
META_PAGE_ID=
META_IG_BUSINESS_ID=

# Graph API version to use
META_GRAPH_VERSION=v21.0

# Port and interface the MCP HTTP server listens on
PORT=3300
HOST=127.0.0.1

# Optional token to protect the /mcp endpoint (header: Authorization: Bearer <value>)
# Leave empty to disable the check (only recommended in local/dev)
MCP_AUTH_TOKEN=

# Public URL (with path if applicable) from which files uploaded with upload_media are served,
# e.g. https://mcp.zenvairo.es/zenvairosocial
MEDIA_BASE_URL=

# Directory where uploaded files are stored (defaults to ./media)
MEDIA_DIR=

# Maximum size (MB) of a file uploaded with upload_media
MAX_UPLOAD_MB=50

# Days uploaded files are kept before being automatically deleted
MEDIA_RETENTION_DAYS=7
