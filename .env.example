# Copia este archivo a .env y rellena los valores

# Token de acceso (largo, 60 dias) del usuario admin de la pagina/cuenta IG
META_ACCESS_TOKEN=

# App ID y App Secret de tu app en developers.facebook.com
META_APP_ID=
META_APP_SECRET=

# Se obtienen con: npm run get-ids
META_PAGE_ID=
META_IG_BUSINESS_ID=

# Version de la Graph API a usar
META_GRAPH_VERSION=v21.0

# Puerto e interfaz donde escucha el servidor HTTP del MCP
PORT=3300
HOST=127.0.0.1

# Token opcional para proteger el endpoint /mcp (header: Authorization: Bearer <valor>)
# Dejalo vacio para desactivar la comprobacion (solo recomendable en local/dev)
MCP_AUTH_TOKEN=
